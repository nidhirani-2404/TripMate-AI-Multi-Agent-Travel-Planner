# Required API Keys & Database URL for Multi-Agent Travel Planner (TripMate AI)

# 1. Groq API Key (Required for LLM - Llama 3.3 70B)
# Get your API key from https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# 2. PostgreSQL Database URL (Required for LangGraph PostgresSaver state persistence)
# Format: postgresql://user:password@hostname:5432/dbname
DATABASE_URL=postgresql://postgres:password@localhost:5432/tripmate_db

# 3. External API Keys for MCP Services (Required for live data fetching)
# Tavily Search API (https://tavily.com)
TAVILY_API_KEY=your_tavily_api_key_here

# AviationStack API (https://aviationstack.com)
AVIATION_STACK_API_KEY=your_aviation_stack_api_key_here

# OpenWeather API (https://openweathermap.org)
OPENWEATHER_API_KEY=your_openweather_api_key_here
